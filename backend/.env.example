# Server
PORT=3001
NODE_ENV=production

# Comma-separated list of allowed frontend origins (no localhost in production)
CORS_ORIGIN=https://your-frontend-domain.com

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Database (SQLite via Prisma; path is relative to backend/prisma/)
DATABASE_URL="file:./dev.db"

# Python inference service (FastAPI sidecar)
INFERENCE_URL=http://localhost:8000
