# Server
PORT=3001
NODE_ENV=production

# Comma-separated list of allowed frontend origins (no localhost in production)
CORS_ORIGIN=https://your-frontend-domain.com

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Database (Neon PostgreSQL)
# Get your connection string from: https://console.neon.tech
# Format: postgresql://username:password@host/database?sslmode=require
DATABASE_URL="postgresql://username:password@ep-xxx-xxx-xxx.us-east-2.aws.neon.tech/aimher?sslmode=require"

# Python inference service (FastAPI sidecar)
INFERENCE_URL=http://localhost:8000
