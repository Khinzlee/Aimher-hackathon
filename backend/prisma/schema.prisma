generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  onboardingCompleted Boolean @default(false)
  onboardingStep      Int      @default(0)
  predictions  Prediction[]
  symptomLogs  SymptomLog[]
  rppgV8Sessions       RppgV8Session[]
  rppgV8Predictions    RppgV8PredictionResult[]
  onboardingProfile    OnboardingProfile?
}

model Prediction {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Raw model inputs: pcos_label + PredFlag/PredScore/RiskProb per disease
  features   String   // JSON
  // Raw model outputs
  result     String   // JSON
  createdAt  DateTime @default(now())

  @@index([userId])
}

model SymptomLog {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day_of_cycle          Int
  cycle_phase           String
  breast_soreness_vas   Float
  painful_touch_vas     Float
  pelvic_pressure_vas   Float
  bloating_delta_cm     Float
  fatigue_mfi5_vas      Float
  acne_severity_likert  Int
  hirsutism_mfg_score   Int
  symptom_burden_score  Float?
  createdAt             DateTime @default(now())

  @@index([userId])
}

model RppgV8Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  rmssd           Float
  hf              Float
  lfHfRatio       Float
  heartRate       Float
  hrv             Float
  estimatedSpO2   Float
  skinTemperature Float
  hrTrend         Float?
  meanEda         Float
  meanTemp        Float
  asi             Float?
  rmssdTrend      Float?

  ac              Float?
  dc              Float?
  acDcRatio       Float?
  pulseAmplitude  Float?
  signalQuality   Float?
  respiratoryRate Float?

  sessionType    String   @default("checkin")
  sessionQuality String?
  capturedAt     DateTime @default(now())

  @@index([userId])
}

model RppgV8PredictionResult {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  predictedAt DateTime @default(now())
  nSessionsUsed Int

  sleepQualityScore      Float?
  focusMemoryScore       Float?
  mentalWellnessScore    Float?
  moodScoreScore         Float?
  metabolicSyndromeScore Float?
  t2dScore               Float?
  cardiovascularScore    Float?
  heartFailureScore      Float?
  chronicStressScore     Float?
  infertilityScore       Float?

  moodCheckLabel         String?
  moodCheckConfidence    Float?
  moodCheckProbabilities String?

  @@index([userId])
}

model OnboardingProfile {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Step 1: Personal Info
  fullName        String?
  dateOfBirth     DateTime?
  age             Int?
  nationality     String?
  ethnicity       String?
  gender          String?
  phoneNumber     String?
  bloodGroup      String?
  genotype        String?

  // Step 2: Physical Measurements
  heightCm Float?
  weightKg Float?
  bmi      Float?

  // Step 3: Skin Changes
  acanthosisNigricans String?
  hasSkinChanges      Boolean?
  skinTags            String?
  scalpHairThinning   String?

  // Step 4: Menstrual History
  cycleLengthDays   Int?
  periodsPerYear    Int?
  lastPeriodDate    DateTime?
  cycleRegularity   String?
  bleedingIntensity String?

  // Additional clinical data
  waistCm           Float?
  hipCm             Float?
  nightSweats       String?
  fatigueLevel      String?
  familyHistory     Json?
  highBloodPressure String?

  // Step 5: Wearable
  selectedWearable String?

  // Step 6: rPPG baseline
  rppgBaselineCaptured Boolean   @default(false)
  rppgCapturedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
